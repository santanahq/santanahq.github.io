---
import { Icon } from "astro-icon/components";

const labSurfaces = [
  { label: "Questions", color: "emerald", icon: "lucide:help-circle" },
  { label: "Systems", color: "indigo", icon: "lucide:cpu" },
  { label: "Math", color: "amber", icon: "lucide:sigma" },
  { label: "Code", color: "sky", icon: "lucide:code-2" },
  { label: "Experiments", color: "violet", icon: "lucide:flask-conical" },
  { label: "Projects", color: "rose", icon: "lucide:arrow-up-right" },
];

const colorMap: Record<string, { text: string; bg: string; border: string }> = {
  emerald: {
    text: "group-hover:text-emerald-600",
    bg: "group-hover:bg-emerald-50",
    border: "group-hover:border-emerald-600",
  },
  indigo: {
    text: "group-hover:text-indigo-600",
    bg: "group-hover:bg-indigo-50",
    border: "group-hover:border-indigo-600",
  },
  amber: {
    text: "group-hover:text-amber-600",
    bg: "group-hover:bg-amber-50",
    border: "group-hover:border-amber-600",
  },
  sky: {
    text: "group-hover:text-sky-600",
    bg: "group-hover:bg-sky-50",
    border: "group-hover:border-sky-600",
  },
  violet: {
    text: "group-hover:text-violet-600",
    bg: "group-hover:bg-violet-50",
    border: "group-hover:border-violet-600",
  },
  rose: {
    text: "group-hover:text-rose-600",
    bg: "group-hover:bg-rose-50",
    border: "group-hover:border-rose-600",
  },
};
---

<section
  id="lab-surface"
  aria-labelledby="lab-surface-title"
  class="border-b border-t border-neutral-200 bg-white px-6 py-20 text-neutral-950 sm:py-28"
>
  <div class="mx-auto max-w-5xl text-center">
    <h2
      id="lab-surface-title"
      class="mt-4 text-4xl font-medium tracking-tight sm:text-6xl"
    >
      A place for any question<br class="hidden sm:block" />
      worth following.
    </h2>

    <p
      class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-neutral-700 sm:text-xl"
    >
      Research can begin with a bug, a proof, an unfamiliar system, a rough
      idea, or something that simply does not make sense yet.
    </p>

    <ul
      class="mx-auto mt-12 flex max-w-3xl flex-wrap justify-center gap-4 sm:mt-16 sm:gap-6"
    >
      {
        labSurfaces.map((item) => (
          <li class="group flex flex-col items-center gap-3">
            <span
              class:list={[
                "flex size-16 items-center justify-center rounded-full border border-neutral-200 bg-white transition-all duration-200 ease-out group-hover:-translate-y-1",
                colorMap[item.color].border,
                colorMap[item.color].bg,
                "sm:size-20",
              ]}
            >
              <Icon
                name={item.icon}
                class:list={[
                  "size-6 text-neutral-950 transition-colors duration-200 ease-out sm:size-7",
                  colorMap[item.color].text,
                ]}
              />
            </span>

            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest text-neutral-500 transition-colors duration-200 ease-out group-hover:text-neutral-950 sm:text-xs">
              {item.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
