---
import RegistryExplorer from "./RegistryExplorer.astro";
import HeroHeading from "./HeroHeading.astro";
---

<section
  id="introduction"
  aria-labelledby="home-hero-title"
  class="border-b border-neutral-200 bg-neutral-50 px-6 pb-24 pt-28 sm:pb-20 sm:pt-24"
>
  <div class="mx-auto max-w-3xl text-center">
    <HeroHeading />

    <p
      class="mx-auto mt-10 max-w-md text-lg leading-relaxed text-neutral-700 sm:mt-8 sm:max-w-xl sm:text-xl"
    >
      A space to research, experiment, and publish what we discover together.
    </p>

    <div class="mt-10 sm:mt-8">
      <RegistryExplorer />
    </div>
  </div>
</section>
