---
import { siteLinks } from "../../data/site";
---

<section
  id="join-the-lab"
  class="border-t border-b border-neutral-200 bg-fuchsia-100 px-6 py-16 text-neutral-950 sm:py-25"
>
  <div
    class="mx-auto flex max-w-5xl flex-col justify-between gap-8 sm:flex-row sm:items-end"
  >
    <div class="group">
      <p
        class="font-mono text-xs font-bold uppercase tracking-widest text-neutral-600"
      >
        Currently open
      </p>

      <h2
        class="mt-4 max-w-2xl text-4xl font-semibold tracking-tight text-neutral-950 sm:text-5xl"
      >
        The lab is open<span
          class="text-neutral-300 transition-colors duration-300 group-hover:text-neutral-950"
          >.</span
        >
      </h2>
    </div>

    <a
      href={siteLinks.discord}
      target="_blank"
      rel="noreferrer"
      class="inline-flex w-fit shrink-0 border border-neutral-950 bg-neutral-950 px-6 py-4 font-mono text-sm font-bold uppercase tracking-widest text-white transition-colors hover:bg-white hover:text-neutral-950"
    >
      Join the lab ↗
    </a>
  </div>
</section>
