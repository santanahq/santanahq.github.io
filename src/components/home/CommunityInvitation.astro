---
import { siteLinks } from "../../config/site";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section
  id="join-the-lab"
  aria-labelledby="join-the-lab-title"
  class="border-y border-neutral-200 bg-fuchsia-100 px-6 py-16 text-neutral-950 sm:py-25"
>
  <div
    class="mx-auto flex max-w-5xl flex-col justify-between gap-8 sm:flex-row sm:items-end"
  >
    <SectionHeading
      eyebrow="Currently open"
      title="The lab is open"
      headingId="join-the-lab-title"
      headingClass="max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl"
      dotClass="text-fuchsia-300"
    />

    <a
      href={siteLinks.discord}
      target="_blank"
      rel="noreferrer"
      class="inline-flex w-fit shrink-0 border border-neutral-950 bg-neutral-950 px-6 py-4 font-mono text-sm font-bold uppercase tracking-widest text-white transition-colors duration-150 hover:bg-transparent hover:text-neutral-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2 focus-visible:ring-offset-fuchsia-100"
    >
      <span>Join the lab</span>
      <span aria-hidden="true"> ↗</span>
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</section>
