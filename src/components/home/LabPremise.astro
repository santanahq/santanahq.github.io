---
import SectionHeading from "../ui/SectionHeading.astro";

const premisePillars = [
  {
    title: "Questions",
    description: "Problems worth understanding.",
    markerClass: "bg-emerald-600",
    titleClass: "text-emerald-600",
    hoverClass: "md:hover:border-emerald-600",
  },
  {
    title: "Experiments",
    description: "Tests, prototypes, and failed attempts.",
    markerClass: "bg-sky-600",
    titleClass: "text-sky-600",
    hoverClass: "md:hover:border-sky-600",
  },
  {
    title: "Records",
    description: "Notes that make later work easier.",
    markerClass: "bg-violet-600",
    titleClass: "text-violet-600",
    hoverClass: "md:hover:border-violet-600",
  },
] as const;
---

<section
  id="the-premise"
  aria-labelledby="lab-premise-title"
  class="border-y border-neutral-200 bg-white px-6 py-16 text-neutral-950 sm:py-20"
>
  <div
    class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-20"
  >
    <SectionHeading
      eyebrow="The premise"
      title="Knowledge should leave a trace"
      headingId="lab-premise-title"
      headingClass="inline-block text-3xl font-medium tracking-tight sm:text-4xl lg:text-5xl"
    />

    <div class="max-w-2xl">
      <p
        class="text-lg leading-relaxed text-neutral-700 sm:text-xl lg:text-2xl"
      >
        A question becomes more useful when its sources, attempts, failures, and
        conclusions remain available for someone else to inspect or continue.
      </p>

      <div
        class="mt-8 grid gap-8 border-t border-neutral-300 pt-6 sm:mt-10 md:grid-cols-3 md:gap-6"
      >
        {
          premisePillars.map((pillar) => (
            <div
              class:list={[
                "group border-b border-transparent pb-2 transition-colors duration-300 ease-out",
                pillar.hoverClass,
              ]}
            >
              <span
                aria-hidden="true"
                class:list={["block h-1 w-8 md:hidden", pillar.markerClass]}
              />

              <p
                class:list={[
                  "mt-4 font-mono text-xs font-bold uppercase tracking-widest md:mt-0",
                  pillar.titleClass,
                ]}
              >
                {pillar.title}
              </p>

              <p class="mt-3 leading-relaxed text-neutral-600 transition-colors duration-300 ease-out group-hover:text-neutral-950">
                {pillar.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
