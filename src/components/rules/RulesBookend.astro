---
interface Props {
  protocol: string;
  lastUpdated: string;
}

const { protocol, lastUpdated } = Astro.props;
---

<section class="px-6 pb-0 pt-0 sm:px-12">
  <div class="mx-auto max-w-3xl bg-black px-6 py-8 sm:px-8 sm:py-10">
    <div
      class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <span
          class="font-mono text-xs font-bold uppercase tracking-widest text-neutral-500"
        >
          {protocol} · Completo
        </span>

        <p
          class="mt-3 max-w-md font-mono text-lg font-bold uppercase leading-snug tracking-tight text-white sm:text-xl"
        >
          Estas reglas se revisan y se aplican con criterio.
        </p>

        <p
          class="mt-3 font-mono text-xs font-bold uppercase tracking-widest text-neutral-400"
        >
          Actualizado / {lastUpdated}
        </p>
      </div>

      <a
        href="/contact"
        class="group inline-flex w-fit items-center gap-2 border-b border-white pb-1 font-mono text-xs font-bold uppercase tracking-widest text-white transition-opacity duration-200 hover:opacity-45"
      >
        Reportar algo
        <span
          class="inline-block transition-transform duration-200 group-hover:translate-x-1"
        >
          ↗
        </span>
      </a>
    </div>
  </div>
</section>
