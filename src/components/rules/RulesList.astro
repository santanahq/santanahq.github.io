---
import { Icon } from "astro-icon/components";

import type { CommunityRule } from "../../data/community-guidelines";

interface Props {
  rules: CommunityRule[];
}

const { rules } = Astro.props;
---

<section class="border-y border-black">
  <ol>
    {
      rules.map((rule, index) => (
        <li
          class:list={[
            "transition-colors duration-200 hover:bg-neutral-50",
            {
              "border-b border-neutral-300": index !== rules.length - 1,
            },
          ]}
        >
          <div class="mx-auto grid max-w-5xl grid-cols-[2rem_2.5rem_minmax(0,1fr)] gap-4 px-6 py-6 sm:grid-cols-[2.5rem_2.5rem_minmax(0,1fr)] sm:gap-5 sm:px-12">
            <span class="pt-2 font-mono text-xs font-bold tabular-nums tracking-widest text-neutral-400">
              {String(index + 1).padStart(2, "0")}
            </span>

            <div class="mt-0.5 grid size-9 place-items-center border border-neutral-300 text-black transition-all duration-200 group-hover:border-black sm:size-10">
              <Icon name={rule.icon} class="size-4.25" aria-hidden="true" />
            </div>

            <div>
              <h2 class="font-mono text-sm font-bold uppercase tracking-wide sm:text-base">
                {rule.title}
              </h2>

              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base">
                {rule.body}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
