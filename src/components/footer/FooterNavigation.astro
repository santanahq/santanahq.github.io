---
import { Icon } from "astro-icon/components";
import { footerNavigation } from "./footer-navigation";
---

<nav
  class="flex flex-wrap items-center gap-5 md:col-span-2 lg:col-span-1 lg:justify-center"
  aria-label="Footer navigation"
>
  {
    footerNavigation.map(({ href, label, icon }) => (
      <a
        href={href}
        class="group inline-flex items-center gap-2 border-b border-transparent pb-0.5 text-sm text-neutral-500 transition-all duration-200 hover:border-neutral-900 hover:text-neutral-900 focus-visible:border-neutral-900 focus-visible:text-neutral-900 focus-visible:outline-none"
      >
        <Icon
          name={icon}
          class="size-4.25 transition-transform duration-300 ease-out group-hover:-translate-y-1 group-hover:scale-110"
          aria-hidden="true"
        />
        {label}
      </a>
    ))
  }
</nav>
