---
import { Icon } from "astro-icon/components";

const footerLinks = [
  {
    href: "/newsletter",
    label: "Newsletter",
    icon: "lucide:mail",
  },
  {
    href: "/rss.xml",
    label: "RSS feed",
    icon: "lucide:rss",
  },
] as const;
---

<div class="flex items-center gap-2 md:justify-end">
  {
    footerLinks.map((link) => (
      <a
        href={link.href}
        aria-label={link.label}
        class="grid size-9 place-items-center border border-neutral-300 text-neutral-950 transition-colors duration-200 hover:border-neutral-950 hover:bg-neutral-950 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
      >
        <Icon name={link.icon} class="size-4" aria-hidden="true" />
      </a>
    ))
  }

  <a
    href="/status"
    class="group relative ml-2 inline-flex items-center gap-2 overflow-hidden border border-neutral-950 px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wide text-neutral-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
  >
    <span
      aria-hidden="true"
      class="absolute inset-0 -translate-x-full bg-neutral-950 transition-transform duration-300 ease-out group-hover:translate-x-0"
    ></span>

    <span
      class="relative transition-colors duration-300 group-hover:text-white"
    >
      Lab signal
    </span>

    <span
      aria-hidden="true"
      class="relative transition-colors duration-300 group-hover:text-white"
    >
      ↗
    </span>
  </a>
</div>
