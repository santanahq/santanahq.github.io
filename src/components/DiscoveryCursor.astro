<div
  id="cursor-ring"
  class="pointer-events-none fixed z-50 hidden size-7 -translate-x-1/2 -translate-y-1/2 rounded-full border border-neutral-950 transition-transform duration-200"
>
</div>

<div
  id="cursor-dot"
  class="pointer-events-none fixed z-50 hidden size-1 -translate-x-1/2 -translate-y-1/2 rounded-full bg-neutral-950"
>
</div>

<script>
  const ringElement = document.querySelector<HTMLElement>("#cursor-ring");
  const dotElement = document.querySelector<HTMLElement>("#cursor-dot");

  if (
    ringElement &&
    dotElement &&
    window.matchMedia("(hover: hover) and (pointer: fine)").matches
  ) {
    const ring = ringElement;
    const dot = dotElement;

    let mouseX = 0;
    let mouseY = 0;
    let ringX = 0;
    let ringY = 0;
    let hasPointerPosition = false;

    window.addEventListener("pointermove", (event) => {
      mouseX = event.clientX;
      mouseY = event.clientY;

      dot.style.left = `${mouseX}px`;
      dot.style.top = `${mouseY}px`;

      if (!hasPointerPosition) {
        ringX = mouseX;
        ringY = mouseY;
        ring.style.left = `${ringX}px`;
        ring.style.top = `${ringY}px`;
        ring.classList.remove("hidden");
        dot.classList.remove("hidden");
        hasPointerPosition = true;
      }
    });

    function animateRing() {
      ringX += (mouseX - ringX) * 0.2;
      ringY += (mouseY - ringY) * 0.2;

      ring.style.left = `${ringX}px`;
      ring.style.top = `${ringY}px`;

      requestAnimationFrame(animateRing);
    }

    animateRing();

    document.addEventListener("pointerover", (event) => {
      const target = event.target as Element;

      if (target.closest("a, button, [role='button']")) {
        ring.classList.add("scale-175");
      }
    });

    document.addEventListener("pointerout", (event) => {
      const target = event.target as Element;
      const relatedTarget = event.relatedTarget as Node | null;
      const interactiveElement = target.closest("a, button, [role='button']");

      if (interactiveElement && !interactiveElement.contains(relatedTarget)) {
        ring.classList.remove("scale-175");
      }
    });
  }
</script>
