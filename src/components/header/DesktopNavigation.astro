---
import type { NavigationItem } from "../../config/navigation";

interface Props {
  items: readonly Pick<NavigationItem, "label" | "href">[];
}

const { items } = Astro.props;
---

<nav
  aria-label="Main navigation"
  class="ml-10 hidden items-center gap-8 xl:flex"
>
  {
    items.map((item) => (
      <a
        href={item.href}
        class="py-2 font-mono text-sm font-bold uppercase tracking-widest text-neutral-950 transition-opacity duration-200 hover:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
      >
        {item.label}
      </a>
    ))
  }
</nav>
