---
import DesktopNavigation from "./DesktopNavigation.astro";
import HeaderBrand from "./HeaderBrand.astro";
import HeaderMenuController from "./HeaderMenuController.astro";
import HeaderNewsletter from "./HeaderNewsletter.astro";
import MenuToggle from "./MenuToggle.astro";
import MobileNavigation from "./MobileNavigation.astro";

import { primaryNavigation } from "../../config/navigation";
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-neutral-200 bg-white text-neutral-950 transition-shadow duration-200"
>
  <div class="mx-auto flex h-18 max-w-6xl items-center px-5 lg:px-8">
    <HeaderBrand />

    <DesktopNavigation items={primaryNavigation} />

    <div class="ml-auto hidden lg:flex">
      <HeaderNewsletter />
    </div>

    <div class="ml-auto lg:hidden">
      <MenuToggle />
    </div>

    <MobileNavigation items={primaryNavigation} />
  </div>

  <HeaderMenuController />
</header>
