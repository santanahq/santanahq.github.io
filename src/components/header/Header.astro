---
import DesktopNavigation from "./DesktopNavigation.astro";
import HeaderBrand from "./HeaderBrand.astro";
import HeaderMenuController from "./HeaderMenuController.astro";
import HeaderNewsletter from "./HeaderNewsletter.astro";
import MenuToggle from "./MenuToggle.astro";
import MobileNavigation from "./MobileNavigation.astro";
import { headerNavigation } from "./header-navigation";
---

<header
  class="sticky top-0 z-50 border-b border-lab-line bg-lab-paper text-lab-ink"
>
  <div class="relative flex h-18 items-center px-5 lg:px-8">
    <div class="order-1 lg:order-2">
      <HeaderBrand />
    </div>

    <div class="hidden lg:order-3 lg:block">
      <DesktopNavigation items={headerNavigation} />
    </div>

    <div class="ml-auto hidden lg:order-4 lg:flex">
      <HeaderNewsletter />
    </div>

    <div class="order-2 ml-auto lg:order-1 lg:ml-0">
      <MenuToggle />
    </div>

    <MobileNavigation items={headerNavigation} />
  </div>

  <HeaderMenuController />
</header>
