---
import type { NavigationItem } from "../../config/navigation";

interface Props {
  items: readonly Pick<NavigationItem, "label" | "href">[];
}

const { items } = Astro.props;
---

<nav
  id="mobile-nav"
  aria-label="Mobile navigation"
  class="absolute inset-x-0 top-full hidden border-b border-neutral-950 bg-white px-5 py-7 shadow-lg lg:px-8"
>
  {
    items.map((item) => (
      <a
        href={item.href}
        class="block border-b border-neutral-950 py-4 font-mono text-xl font-bold uppercase tracking-widest text-neutral-950 transition-opacity duration-200 hover:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
      >
        {item.label}
      </a>
    ))
  }

  <a
    href="/newsletter"
    class="mt-6 flex h-16 items-center justify-center border border-neutral-950 font-mono text-base font-bold uppercase tracking-widest text-neutral-950 transition-colors duration-200 hover:bg-neutral-950 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
  >
    Newsletter
  </a>
</nav>
