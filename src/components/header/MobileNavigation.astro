---
import type { HeaderNavigationItem } from "./header-navigation";

interface Props {
  items: HeaderNavigationItem[];
}

const { items } = Astro.props;
---

<nav
  id="mobile-nav"
  class="absolute inset-x-0 top-full hidden border-b border-black bg-white px-5 py-7 shadow-lg lg:px-8"
  aria-label="Menú de navegación"
>
  <div class="flex flex-col">
    {
      items.map((item) => (
        <a
          href={item.href}
          class="border-b border-black py-4 font-mono text-xl font-bold uppercase tracking-widest text-black transition-opacity duration-200 hover:opacity-50"
        >
          {item.label}
        </a>
      ))
    }
  </div>

  <a
    href="/newsletter"
    class="mt-6 flex h-16 items-center justify-center border border-black font-mono text-base font-bold uppercase tracking-widest text-black transition-colors duration-200 hover:bg-black hover:text-white"
  >
    Newsletter
  </a>
</nav>
