---
import { SEO } from "astro-seo";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../styles/global.css";
import DiscoveryCursor from "../components/DiscoveryCursor.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og-cover.jpg",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/webp"
      href="/main-light.webp"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/webp"
      href="/main-dark.webp"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      titleTemplate="%s | Labs"
      titleDefault="Labs"
      description={description}
      canonical={canonicalURL.toString()}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: socialImageURL.toString(),
          url: canonicalURL.toString(),
        },
        optional: {
          description,
          siteName: "Labs",
          locale: "en_US",
        },
        image: {
          alt: title,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: socialImageURL.toString(),
      }}
      extend={{
        link: [
          { rel: "sitemap", href: "/sitemap-index.xml" },
          {
            rel: "alternate",
            type: "application/rss+xml",
            title: "Labs RSS",
            href: "/rss.xml",
          },
        ],
        meta: [{ name: "theme-color", content: "#0f0f0f" }],
      }}
    />
  </head>
  <body>
    <Header />
    <main class="bg-zinc-100">
      <slot />
    </main>
    <Footer />
    <DiscoveryCursor />
  </body>
</html>
